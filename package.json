{
  "name": "pi-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local Pi workflow, session usage, fixed footer, background Bash, and unified subagent extension.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "claude-agent-sdk",
    "codex-acp"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "node test/grouped-tools.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/unified-subagents/e2e --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "biome check index.ts pi-toolkit-lib/ test/",
    "lint:fix": "biome check --fix index.ts pi-toolkit-lib/ test/",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@sinclair/typebox": "^0.34.49",
    "croner": "^10.0.1",
    "nanoid": "^5.1.16",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^25.5.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0",
    "@earendil-works/pi-tui": ">=0.81.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
